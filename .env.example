# Copy this file to .env, then fill in the keys you need. Never commit .env.

# Used by both full councils and the "Talk to them" advisor chat (GPT-6 Luna).
OPENAI_API_KEY=
CHAT_MAX_TOKENS=2500

# The normal web workflow. Set to "viewer" only to replay externally-created sessions.
COUNCIL_RUNNER=api

# One active AI sequence per public IP per UTC day. Set a stable random value in production.
DAILY_LIMIT_SECRET=
# Only enable when a trusted reverse proxy overwrites X-Real-IP with the visitor's address.
TRUST_PROXY=false

# Optional maintainer tool: used to generate portraits when adding an advisor (about 5 image jobs each).
# Get a key at https://kie.ai/api-key
KIE_AI_API_KEY=
